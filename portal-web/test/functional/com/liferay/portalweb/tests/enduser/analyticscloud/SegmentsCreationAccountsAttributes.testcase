@component-name = "portal-analytics-cloud"
definition {

	property analytics.cloud.enabled = "true";
	property minimum.slave.ram = "24";
	property portal.release = "false";
	property portal.upstream = "true";
	property slave.label = "slave-1";
	property testray.main.component.name = "Analytics Cloud";

	setUp {
		task ("Copy the token from AC") {
			ACUtils.launchAC();

			ACSettings.takeTokenFromAnalyticsCloud();
		}

		task ("Set up instance and sign in DXP") {
			TestCase.setUpPortalInstance();

			ACUtils.launchDXP();
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		ACUtils.tearDownDXP();

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}

		ACUtils.tearDownAC();
	}

	@description = "Feature ID: Legacy | Automation ID: LRAC-9201 | Test Summary: Create a Dynamic Accounts Segment"
	@priority = "5"
	test CanCreateDynamicSegmentAccountsAttributes {
		task ("Go to AC and go to segments") {
			ACUtils.launchAC();

			ACNavigation.goToSegments();
		}

		task ("Add a new dynamic segment that includes anonymous users") {
			ACSegments.createDynamicSegment();

			ACSegments.nameSegment(segmentName = "Dynamic Segment Test");

			ACSegments.includeAnonymous();
		}

		task ("Select Account Attributes and add a segment field") {
			ACSegments.goToSidebarAttributes(criterion = "Account Attributes");

			ACSegments.addSegmentField(segmentField = "accountName");

			ACSegments.selectOperator(operator = "is unknown");

			ACSegments.saveSegment();
		}

		task ("Go to segments and assert that the segment was created") {
			ACNavigation.goToSegments();

			ACUtils.searchBar(searchItem = "Dynamic Segment Test");

			AssertElementPresent(
				key_assetName = "Dynamic Segment Test",
				locator1 = "ACAssets#ASSETS_TABLE");
		}
	}

}